      "name": "Authentication",
      "item": [
        {
          "name": "[USER] Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Safely parse JSON response and extract common values",
                  "// Guard against cases where pm.response is not available (e.g., request failed before a response)",
                  "let json;",
                  "",
                  "pm.test(\"Response received\", function () {",
                  "    pm.expect(pm.response, \"pm.response should exist\").to.exist;",
                  "});",
                  "",
                  "// If there's no response at all, stop here to avoid script errors",
                  "if (!pm.response) {",
                  "    // nothing to extract",
                  "    return;",
                  "}",
                  "",
                  "// Only attempt JSON parsing when response is JSON-like",
                  "const responseText = (typeof pm.response.text === 'function') ? pm.response.text() : '';",
                  "const trimmed = (responseText || '').trim();",
                  "const contentType = ((pm.response.headers && pm.response.headers.get('Content-Type')) || '').toLowerCase();",
                  "const looksLikeJson = contentType.includes('application/json') || trimmed.startsWith('{') || trimmed.startsWith('[');",
                  "",
                  "if (looksLikeJson) {",
                  "    try {",
                  "        json = pm.response.json();",
                  "    } catch (e) {",
                  "        json = undefined;",
                  "    }",
                  "}",
                  "",
                  "if (json && typeof json === 'object') {",
                  "    if (json.token) {",
                  "        pm.collectionVariables.set('token', json.token);",
                  "    }",
                  "",
                  "    // Save first account id, if present",
                  "    const firstAccountId = Array.isArray(json.accounts) && json.accounts[0] ? json.accounts[0].id : undefined;",
                  "    if (firstAccountId !== undefined && firstAccountId !== null) {",
                  "        pm.collectionVariables.set('accountId', firstAccountId);",
                  "    }",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"Sabrina\",\r\n  \"password\": \"Sabrina21\",\r\n  \"email\": \"sabcarter@bank.com\",\r\n  \"firstName\": \"Sabrina\",\r\n  \"lastName\": \"Carter\",\r\n  \"accountType\": \"BOTH\",\r\n  \"initialDebitBalance\": 25000.00\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Save auth token from login response into the active environment (Dev)",
                  "",
                  "pm.test(\"Login succeeded\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "let json;",
                  "try {",
                  "    json = pm.response.json();",
                  "} catch (e) {",
                  "    json = {};",
                  "}",
                  "",
                  "// Common token field names: token, access_token, accessToken",
                  "const token = json.token || json.access_token || json.accessToken;",
                  "",
                  "pm.test(\"Token is present in response\", function () {",
                  "    pm.expect(token, \"token in response body\").to.be.a(\"string\").and.not.be.empty;",
                  "});",
                  "",
                  "if (token) {",
                  "    pm.environment.set(\"token\", token);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"admin\",\r\n  \"password\": \"admin123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
