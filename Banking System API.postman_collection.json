                "exec": [
                  "// Minimal post-response tests for Delete user",
                  "pm.test('Response received', function () {",
                  "  pm.expect(pm.response).to.exist;",
                  "});",
                  "",
                  "const status = pm.response.code;",
                  "",
                  "// Expected outcomes: 200 OK (body) or 204 No Content",
                  "pm.test('Delete user should succeed (200 or 204)', function () {",
                  "  pm.expect([200, 204], `Unexpected status: ${status}`).to.include(status);",
                  "});",
                  "",
                  "// If failing, capture details to make debugging easier",
                  "if (![200, 204].includes(status)) {",
                  "  const details = {",
                  "    request: {",
                  "      method: pm.request.method,",
                  "      url: pm.request.url && pm.request.url.toString(),",
                  "      headers: pm.request.headers && pm.request.headers.toObject()",
                  "    },",
                  "    response: {",
                  "      code: status,",
                  "      headers: pm.response.headers && pm.response.headers.toObject(),",
                  "      body: pm.response.text()",
                  "    }",
                  "  };",
                  "",
                  "  console.log('Delete user failure details:', details);",
                  "",
                  "  pm.test('Failure details logged to console', function () {",
                  "    pm.expect(details.response.body).to.be.a('string');",
                  "  });",
                  "}",
                  ""
