              "listen": "test",
              "script": {
                "exec": [
                  "// Delete account - response validations",
                  "",
                  "pm.test(\"Status is one of 200/204/404 (not 500)\", function () {",
                  "    pm.expect([200, 204, 404]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test(\"Does not return 500\", function () {",
                  "    pm.expect(pm.response.code).to.not.equal(500);",
                  "});",
                  "",
                  "// If a 5xx occurs, surface details to help debugging",
                  "if (pm.response.code >= 500) {",
                  "    let bodyText = pm.response.text();",
                  "    pm.test(\"5xx response body (for debugging)\", function () {",
                  "        pm.expect(bodyText, \"Server returned 5xx. Body: \" + bodyText).to.be.a(\"string\");",
                  "    });",
                  "}",
